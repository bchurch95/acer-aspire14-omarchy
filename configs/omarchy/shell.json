    "ben.media",
    "ben.agents",
    "ben.menu",
    "ben.notifications"
  ],
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.agents",
    "omarchy.menu",
    "omarchy.notifications"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
