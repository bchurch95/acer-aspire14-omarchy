        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "ben.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "io.github.vuhungthang.monitor-studio"
        },
        {
          "id": "ben.power",
          "showPercentage": false
        }
      ]
