          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ben.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "ben.apple-music-button"
        },
        {
          "id": "ben.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "thefreshoffice.speaker-calibrator"
        },
        {
          "id": "nosignal.omalava"
        },
        {
          "id": "io.github.bchurch95.omarchy-universal-cast"
        },
        {
          "id": "sysinfo",
          "type": "qml"
        },
        {
          "id": "nosignal.omasend"
        },
        {
          "id": "nixfred.blip"
        },
        {
          "id": "omamail"
        },
        {
          "id": "jankeesvw.time-machine"
        },
        {
          "id": "isaact135.network-shares"
        },
        {
          "id": "io.github.zachwilke.mx"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "jkoestinger.vpn"
        },
        {
          "id": "ben.agents",
