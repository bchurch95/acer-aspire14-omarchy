    "secondaryLayout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.audio"
        },
        {
