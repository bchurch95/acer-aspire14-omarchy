{
  "schemaVersion": 1,
  "id": "ben.menu",
  "name": "My Menu",
  "version": "1.0.0",
  "author": "Ben Church",
  "description": "Quickshell-powered Omarchy command menu featuring an authentic Quake II emblem status bar button.",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "My Menu",
    "description": "Launches the Omarchy menu",
    "category": "Compositor",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  }
}
